{
  "tasks": [
    {
      "type": "cppbuild",
      "label": "C/C++: g++ 生成活动文件",
      "command": "g++",
      "args": [
        "-fdiagnostics-color=always",
        "-g",
        "${file}",
        "-std=c++23",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}"
      ],
      "options": {
        "cwd": "${fileDirname}",
        "platform": {
          "win32": {
            "command": "D:\\mingw64\\bin\\g++.exe",
            "args": [
              "-fdiagnostics-color=always",
              "-g",
              "${file}",
              "-std=c++23",
              "-o",
              "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ]
          },
          "linux": {
            "command": "/usr/bin/g++",
            "args": [
              "-fdiagnostics-color=always",
              "-g",
              "${file}",
              "-std=c++23",
              "-o",
              "${fileDirname}/${fileBasenameNoExtension}"
            ]
          }
        }
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "跨平台 g++ 构建任务"
    }
  ],
  "version": "2.0.0"
}
